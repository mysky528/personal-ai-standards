{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAISL Standard Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "version", "status", "kind", "category",
    "name", "description", "purpose", "scope",
    "sources", "rules", "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PAISL-(COMM|REAS|PROD|VIS|VER|ENG)-[0-9]{3}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": ["draft", "review", "verified", "deprecated"]
    },
    "kind": {
      "enum": [
        "formal_standard", "style_guide",
        "methodology", "framework", "practice"
      ]
    },
    "category": {
      "enum": [
        "communication", "reasoning", "productivity",
        "visualization", "verification", "engineering"
      ]
    },
    "name": {"$ref": "#/$defs/bilingual"},
    "description": {"$ref": "#/$defs/bilingual"},
    "purpose": {"$ref": "#/$defs/bilingual"},
    "scope": {"$ref": "#/$defs/bilingual"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "type"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "type": {
            "enum": ["official", "primary", "secondary"]
          },
          "note": {"type": "string"}
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "instruction", "rationale"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]{3}$"
          },
          "instruction": {"$ref": "#/$defs/bilingual"},
          "rationale": {"$ref": "#/$defs/bilingual"},
          "severity": {"enum": ["must", "should", "may"]}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/bilingual"}
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh-CN"],
      "properties": {
        "en": {"type": "string", "minLength": 1},
        "zh-CN": {"type": "string", "minLength": 1}
      }
    }
  }
}
