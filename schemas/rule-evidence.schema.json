{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: MIT",
  "title": "PAISL Rule Evidence Link",
  "description": "The links between the rules of one Standard and the evidence records that support them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "standard_id", "standard_version", "rules"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "standard_id": {
      "type": "string",
      "pattern": "^PAISL-(COMM|REAS|PROD|VIS|VER|ENG)-[0-9]{3}$"
    },
    "standard_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "evidence"],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^R[0-9]{3}$"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_id", "relationship"],
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "pattern": "^EVD-[0-9]{4}$"
                },
                "relationship": {
                  "enum": ["supports", "context", "contradicts"]
                },
                "locator": {
                  "type": ["string", "null"],
                  "minLength": 1
                },
                "note": {
                  "type": ["string", "null"],
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
